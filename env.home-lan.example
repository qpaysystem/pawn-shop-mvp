# Шаблон Laravel .env для параллельной копии lombard.home (Docker на vm-web-host-01).
# Боевой Timeweb не заменяет; отдельная БД. CRM сюда не переносим.
# Скопировать на сервере: cp env.home-lan.example app/.env (из корня pawn-shop-mvp)
# Пароли БД — как MYSQL_* в .env docker-compose стека lombard-portal.

APP_NAME="Ломбард MVP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://lombard.home
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru

DB_CONNECTION=mysql
DB_HOST=lombard-mysql
DB_PORT=3306
DB_DATABASE=pawn_shop
DB_USERNAME=pawn
DB_PASSWORD=change-me

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Явно false: иначе на http:// браузер не сохранит cookie сессии (редирект после логина «ломается»).
SESSION_SECURE_COOKIE=false

LOG_CHANNEL=stack
LOG_LEVEL=error

CACHE_STORE=file
QUEUE_CONNECTION=sync

LOMBARD_NAME="Ломбард"
LOMBARD_PHONE="+7 (383) 291-00-51"

# Телефония MTS (колл-центр) — те же значения, что на Timeweb. С Mac:
#   ./scripts/push-mts-env-to-home-lan.sh
# MTS_TELEPHONY_API=auto
# MTS_VPBX_URL=https://vpbx.mts.ru
# MTS_VPBX_PASSWORD=
# MTS_AC20_DOMAIN=
# MTS_AC20_TRUNK_ID=

# agent-teams-portal: секрет для API звонков MTS (предпочтительно в админке:
# Настройки → Системные настройки → «Портал ИИ-агентов»; тот же токен в agent-teams.home)
# AGENT_TEAMS_API_TOKEN=change_me_secret
# AGENT_TEAMS_PORTAL_URL=http://agent-teams.home
# MTS_AUTO_ENRICH=true
# MTS_AUTO_ENRICH_LIMIT=25
# Планировщик: каждые 10 мин (php artisan schedule:work в контейнере lombard-scheduler)
# MTS_PIPELINE_ENABLED=true
# MTS_PIPELINE_SYNC_DAYS=1
# MTS_PIPELINE_ENRICH_LIMIT=10
# AGENT_TEAMS_NOTIFY_ON_TRANSCRIPT=true
# OPENAI_API_KEY=  # Whisper + оформление расшифровки, если нет STT от МТС

# info.acuerdo.pro — отчёты «Текущий актив» / «Текущие финансы» (Управление → Отчёты)
# Те же учётные данные, что в agent-teams-portal; можно задать в админке: Настройки → Системные настройки
# ACUERDO_INFO_BASE_URL=https://info.acuerdo.pro
# ACUERDO_CONF_BASE_URL=https://conf.nnfm.pro
# ACUERDO_USERNAME=
# ACUERDO_PASSWORD=
# ACUERDO_MEETING_ROOM="Комната совещаний"

# БД 1С (PostgreSQL) — синк клиентов/залогов. С Mac: ./scripts/push-lmb-env-to-home-lan.sh
# LMB_DB_DRIVER=pgsql
# LMB_DB_HOST=192.168.7.250
# LMB_DB_PORT=5432
# LMB_DB_DATABASE=lmb
# LMB_DB_USERNAME=lmb
# LMB_DB_PASSWORD=lmb
