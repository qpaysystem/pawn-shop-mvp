# Дополнение к app/.env на домашнем сервере при доступе с iPhone по Tailscale.
# Скопируйте нужные строки в /opt/stacks/prod/lombard-portal/app/.env
#
# TS_IP = tailscale ip -4 на сервере

APP_URL=http://100.64.x.x:8000

# Для mobile API Sanctum (Bearer) CORS не нужен; важно, чтобы с телефона открывался:
#   POST http://100.64.x.x:8000/api/v1/auth/login
