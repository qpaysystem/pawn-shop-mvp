{
  "name": "mobile-app",
  "main": "index.js",
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:phone": "sh -c 'lsof -ti :8081 | xargs kill 2>/dev/null; lsof -ti :8082 | xargs kill 2>/dev/null'; expo start -c --tunnel",
    "start:app": "EXPO_PUBLIC_DEBUG_TOUCH=false expo start -c --tunnel",
    "start:touch-debug": "EXPO_PUBLIC_DEBUG_TOUCH=true expo start -c --tunnel",
    "start:tunnel": "expo start -c --tunnel",
    "start:tailscale": "REACT_NATIVE_PACKAGER_HOSTNAME=$(tailscale ip -4 2>/dev/null || echo 127.0.0.1) expo start -c --lan",
    "start:tailscale:debug": "REACT_NATIVE_PACKAGER_HOSTNAME=100.124.207.97 EXPO_PUBLIC_DEBUG_TOUCH=true expo start -c --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "qa:smoke": "tsx scripts/qa-smoke.ts",
    "env:wan": "bash scripts/set-mobile-env-wan.sh",
    "env:home": "bash scripts/set-mobile-env-home-lan.sh",
    "ios:device": "bash scripts/rebuild-ios-device.sh"
  },
  "private": true
}
