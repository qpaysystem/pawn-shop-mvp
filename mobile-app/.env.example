# Copy to .env and adjust for your machine.

# Backend origin (без /api/v1 — путь добавится автоматически).
# iOS Simulator на Mac: http://127.0.0.1:8000
# iPhone / Expo Go:
#   Mac (разработка):     tailscale ip -4 на Mac → http://100.x.x.x:8000
#   Домашний сервер:      tailscale ip -4 на сервере → http://100.y.y.y:8000
#   из корня репо:       ./scripts/set-mobile-env-tailscale.sh 100.y.y.y 8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# true = mock auth. false = POST/GET /api/v1/auth/* на домашнем сервере.
EXPO_PUBLIC_USE_MOCK_API=true

# true = mock залоги/клиенты/справочники. false = реальная БД через /api/v1/*.
EXPO_PUBLIC_USE_MOCK_DATA=true

EXPO_PUBLIC_APP_NAME=Ломбард

# true = минимальный красный экран TOUCH DEBUG (без expo-router)
# EXPO_PUBLIC_DEBUG_TOUCH=false

# Опционально: таймаут HTTP (мс)
# EXPO_PUBLIC_API_TIMEOUT_MS=30000

# iPhone не видит 192.168.1.67: Tailscale Connected + Expo Go «Локальная сеть» ВКЛ.
# Временно без backend: EXPO_PUBLIC_USE_MOCK_API=true

# Metro / Expo Go (если ошибка "Could not connect to development server"):
#   npm run start:tunnel     — через интернет (самый надёжный)
#   npm run start:tailscale  — Mac и iPhone в Tailscale (IP Mac: tailscale ip -4)
#   npm run start            — только если iPhone в той же Wi‑Fi, что Mac
